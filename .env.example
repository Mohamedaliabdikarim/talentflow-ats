# Copy to .env.local and fill in values. Never commit .env.local.
# Names only; see docs/DEPLOYMENT.md for where each value comes from.

# Public (safe for the browser; RLS protects the data)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server only - never expose
SUPABASE_SERVICE_ROLE_KEY=

# Optional AI insights (server only)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# Optional, raises the GitHub public API rate limit (server only)
GITHUB_TOKEN=
