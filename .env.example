# Copy to .env.local and fill in values. Never commit .env.local.
# Names only; see docs/DEPLOYMENT.md and docs/SUPABASE_INTEGRATION.md for where each value comes from.
#
# Next.js inlines NEXT_PUBLIC_* values into the build. Leave a line commented out until you have
# the value: an empty value is baked in as an empty string and cannot be overridden at runtime.
# In CI and for Azure, NEXT_PUBLIC_* must therefore be present in the BUILD environment.

# Public (safe for the browser; RLS protects the data). Accepts the legacy anon JWT or the
# newer publishable key (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server only - never expose. Legacy service_role JWT or the newer secret key (sb_secret_...).
SUPABASE_SERVICE_ROLE_KEY=

# Hosted migration tooling (scripts/db/hosted.mjs), server/operator only.
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# Optional AI insights (server only)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
# Optional: only if the Azure v1 endpoint requires an explicit api-version query.
AZURE_OPENAI_API_VERSION=
# Shared secret (>= 16 chars, e.g. `openssl rand -hex 32`) for POST /api/insights/run, the internal
# runner that processes queued Candidate Insights. Server only. Without it, queued analyses wait
# for a manual retry or a scheduled call (docs/AI_INSIGHTS.md §5).
INSIGHTS_RUNNER_SECRET=

# Optional, raises the GitHub public API rate limit (server only)
GITHUB_TOKEN=

# Optional fallback for IPv4-only networks: Supavisor pooler host (not a secret), e.g. aws-0-eu-north-1.pooler.supabase.com
SUPABASE_POOLER_HOST=
